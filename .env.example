# Copy to .env.local for local development. Find these in Supabase → Project Settings → API.
# The publishable key (or legacy anon key) is safe to ship to browsers; row level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
